{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowLambdaToReadSpecificFolder",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::tech-for-future-bucket",
                "arn:aws:s3:::tech-for-future-bucket/inbound_data/*"
            ],
            "Condition": {
                "IpAddress": {
                    "aws:SourceIp": "192.0.2.0/24"
                }
            }
        },
        {
            "Sid": "AllowLambdaToWriteLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:us-west-2:123456789012:log-group:/aws/lambda/tech-for-future-processor:*"
        }
    ]
}
